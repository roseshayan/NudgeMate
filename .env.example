# ==========================================
# NudgeMate - Environment Configuration
# ==========================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram User ID (numeric, e.g. 123456789 from @userinfobot)
ADMIN_CHAT_ID=your_numeric_telegram_user_id

# Dahl Inference API Settings (https://inference.dahl.global)
DAHL_API_KEY=your_dahl_api_key_here
DAHL_BASE_URL=https://inference.dahl.global/v1
DAHL_MODEL=MiniMaxAI/MiniMax-M2.7

# Multi-Engine Speech-to-Text (STT) Settings
# Options: auto (default: Groq/Google -> Local fallback), google, groq, openai, local
STT_ENGINE=auto

# Optional Cloud STT Keys for ultra-fast Whisper Large V3
GROQ_API_KEY=
OPENAI_API_KEY=

# Local Whisper Settings (Offline fallback or when STT_ENGINE=local)
# Models: tiny, base, small
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Timezone & Localization
TIMEZONE=Asia/Tehran

# Nagging & Snooze Logic (In minutes)
NAG_INTERVAL_MINUTES=15
MAX_NAG_COUNT=3

# Daily Morning Briefing (24h format HH:MM)
DAILY_BRIEFING_ENABLED=true
DAILY_BRIEFING_TIME=08:30

# MeliPayamak SMS Settings (https://melipayamak.com/?aff=DBMRN - 10% coupon: MPDBMRN)
MELIPAYAMAK_API_TOKEN=0cd932c7f08946509b95519513bbc4be
MELIPAYAMAK_FROM_NUMBER=
MELIPAYAMAK_SHARED_BODY_ID=0

# Mandatory Channel Join (Force Join, e.g. @MyChannel or channel ID)
REQUIRED_CHANNEL=
CHANNEL_INVITE_LINK=

# Auto-Update Settings
CHECK_UPDATES=true
UPDATE_CHECK_INTERVAL_HOURS=2
GITHUB_REPO=roseshayan/NudgeMate

# Storage
DATABASE_PATH=data/nudgemate.db
TEMP_AUDIO_DIR=temp_audio
